# =============================================================================
# Environment Variables — MathEncode
# =============================================================================
# Copy this file to `.env.local` and fill in the values.
# Next.js loads `.env.local` automatically. Do not commit real secrets.

# -----------------------------------------------------------------------------
# Database (MongoDB)
# -----------------------------------------------------------------------------
# Local example:
# MONGODB_URI=mongodb://127.0.0.1:27017/mathencode
# Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mathencode?retryWrites=true&w=majority
MONGODB_URI=

# -----------------------------------------------------------------------------
# Authentication (JWT)
# -----------------------------------------------------------------------------
# REQUIRED — secret used to sign admin session tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# -----------------------------------------------------------------------------
# Admin seeding
# -----------------------------------------------------------------------------
# REQUIRED by `pnpm create-admin`. This is not a public registration key.
# The seed script refuses to run unless this value is set (at least 16 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SETUP_SECRET=

# Optional. When both are set, `pnpm create-admin` runs without prompts.
# This is the same command for localhost and production — point MONGODB_URI
# at the database you want to seed. Re-running does not create a duplicate.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
